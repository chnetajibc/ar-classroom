# Copy to publisher.env (git-ignored) and fill in. Used by tools/build_docs.sh and tools/build_release.sh
# to replace the [PUBLISHER NAME] / [SUPPORT EMAIL] / [WEBSITE] / [JURISDICTION] placeholders in the PDF and the EULA.
# One KEY="value" per line. Quotes are optional, spaces and & are fine, no comments after a value.
PUBLISHER_NAME="Your Name or Studio"
SUPPORT_EMAIL="support@example.com"
WEBSITE="https://example.com"
JURISDICTION="Your country/state whose law governs the EULA"
